# cp .env.example .env
#
# Optional. By default the dev server proxies /graphql and /auth to http://localhost:4000
# (set DEV_API_URL in your shell to change the target), so development is same-origin like production.
# Set VITE_API_URL only to call an API on another origin: it needs CORS with credentials, and the
# production nginx CSP (connect-src 'self') must be relaxed to allow it.
# VITE_API_URL=http://localhost:4000/graphql
